<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AkariDash.App</RootNamespace>
    <!-- The exe and its files are named for people, "Akari Dash.exe"; the namespace stays AkariDash.App. -->
    <AssemblyName>Akari Dash</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The AkariOS logo behind every page. -->
    <Content Include="Assets\img.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- AkariOS-Ultimate's removal and install scripts for the Legacy apps tab, read back by name. -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts\*.ps1" LogicalName="AkariDash.App.Scripts.%(Filename)%(Extension)" />
    <!-- The Drivers page: AkariOS-Ultimate's Graphics scripts, 1:1, and the helpers they run after. -->
    <EmbeddedResource Include="Scripts\Graphics\*.ps1" LogicalName="AkariDash.App.Scripts.Graphics.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Publish leaves out the app's own resources.pri and its compiled XAML pages (.xbf), and
       without them the app cannot load a single page. Copy them from the build output. -->
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <_XamlResource Include="$(OutDir)$(TargetName).pri" />
      <_XamlResource Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlResource)" DestinationFiles="@(_XamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AkariDash.Core\AkariDash.Core.csproj" />
    <ProjectReference Include="..\AkariDash.Framework\AkariDash.Framework.csproj" />
    <!-- Referenced so the build puts the companion beside the app, which is where the app looks for
         it when it stages a safe-mode pass. Nothing in the app calls into it. -->
    <ProjectReference Include="..\AkariDash.DefenderReset\AkariDash.DefenderReset.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

</Project>
