<Page
    x:Class="AkariDash.App.Views.CustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AkariDash.App.Views">

    <Grid Padding="24,16,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
            <SelectorBarItem Text="Start menu">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8FC;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Taskbar">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="File Explorer">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xEC50;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <ScrollViewer x:Name="StartMenuTab" Grid.Row="1" Padding="0,0,0,24">
            <views:CategoryView ViewModel="{x:Bind ViewModel.StartMenu}" />
        </ScrollViewer>
        <ScrollViewer x:Name="TaskbarTab" Grid.Row="1" Padding="0,0,0,24" Visibility="Collapsed">
            <views:CategoryView ViewModel="{x:Bind ViewModel.Taskbar}" />
        </ScrollViewer>
        <ScrollViewer x:Name="ExplorerTab" Grid.Row="1" Padding="0,0,0,24" Visibility="Collapsed">
            <views:CategoryView ViewModel="{x:Bind ViewModel.Explorer}" />
        </ScrollViewer>
    </Grid>
</Page>
