<Page
    x:Class="AkariDash.App.Views.UwpAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariDash.App.ViewModels">

    <Page.Resources>
        <CollectionViewSource x:Name="DriverGroups" IsSourceGrouped="True" Source="{x:Bind ViewModel.Drivers.Groups}" />
        <CollectionViewSource x:Name="DeviceGroups" IsSourceGrouped="True" Source="{x:Bind ViewModel.Devices.Groups}" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

                <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <SelectorBarItem Text="Store apps" IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7B8;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Restoration">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE777;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Features">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xEA86;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Uninstaller">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Drivers">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE964;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Devices">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE772;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Drives">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xEDA2;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- Store apps: Vain Toolbox's Appx table, with AkariOS-Ultimate's Remove all bloatware. -->
        <Grid x:Name="StoreAppsTab" Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Grid.Column="1"
                    MinWidth="140"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind vm:StoreAppsViewModel.Filters}"
                    SelectedIndex="{x:Bind ViewModel.StoreApps.FilterIndex, Mode=TwoWay}" />
                <AutoSuggestBox
                    Grid.Column="2"
                    Width="240"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    PlaceholderText="Search apps"
                    Text="{x:Bind ViewModel.StoreApps.SearchText, Mode=TwoWay}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.StoreApps.RefreshCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Content="Remove all bloatware"
                    Command="{x:Bind ViewModel.StoreApps.RemoveAllBloatwareCommand}"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Foreground="White" />
            </Grid>

            <TextBlock
                Grid.Row="1"
                TextWrapping="Wrap"
                Opacity="0.8"
                Text="Removing an app here removes it for every user, and Windows will not put it back, not even with a feature update. Restoration brings it back if you need it." />

            <Border
                Grid.Row="2"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,10" ColumnSpacing="12" Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="APP NAME" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="PUBLISHER" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="VERSION" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Text="ARCHITECTURE" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        Padding="0,0,16,0"
                        SelectionMode="None"
                        ItemsSource="{x:Bind ViewModel.StoreApps.Filtered, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StoreAppRowViewModel">
                                <Grid Padding="8,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                                            <Image Width="32" Height="32" Stretch="Uniform" Source="{x:Bind Icon, Mode=OneWay}" />
                                            <FontIcon FontSize="18" Opacity="0.8" Glyph="&#xE71D;" Visibility="{x:Bind IsIconMissing, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind PackageName}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Publisher}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Version}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Architecture}" />
                                    <Button
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        ToolTipService.ToolTip="Remove"
                                        Visibility="{x:Bind IsRemovable}"
                                        Command="{x:Bind RemoveCommand}"
                                        CommandParameter="{x:Bind}">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Opacity="0.6"
                                        TextWrapping="Wrap"
                                        TextAlignment="Right"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Visibility="{x:Bind IsProtected}"
                                        Text="{x:Bind ProtectedText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.StoreApps.StatusText, Mode=OneWay}" />
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.StoreApps.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Restoration: FSOS-X's cards, for every curated app that is not installed. Every card is
             as tall as the first one measured, and that one changes while scrolling, so every card has
             the same fixed height, with room for a three-line description. -->
        <Grid x:Name="RestorationTab" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.8"
                    Text="Reinstall Windows apps that were removed, by Akari-Dash or anything else. A Store app comes back from the copy still on this PC when Windows kept one, otherwise from the Microsoft Store; Edge, WebView2, OneDrive and the other built-in programs come back with AkariOS-Ultimate&apos;s installers. Most need an internet connection." />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.Restoration.StatusText, Mode=OneWay}" />
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.Restoration.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Padding="0,0,16,0">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Restoration.Missing, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="300"
                            MinItemHeight="186"
                            MinRowSpacing="8"
                            MinColumnSpacing="8"
                            MaximumRowsOrColumns="3"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RestorableAppViewModel">
                            <Grid
                                Height="186"
                                Padding="18,16"
                                RowSpacing="10"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontSize="24" Glyph="&#xE71D;" />
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Text="{x:Bind Status}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{x:Bind Description}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                    <Button Content="Restore" Command="{x:Bind RestoreCommand}" CommandParameter="{x:Bind}" />
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsRestoring, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Features: Vain Toolbox's Features tab, Windows features and optional features (capabilities),
             with AkariOS-Ultimate's UWP Features and Legacy Features removal as Remove all. -->
        <Grid x:Name="FeaturesTab" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="Before you change a feature">
                    <FontIcon FontSize="14" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel MaxWidth="320" Spacing="6">
                                <TextBlock Text="Important" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    TextWrapping="Wrap"
                                    Text="Turning a feature off can turn off what depends on it, and most changes need a restart. Adding an optional feature downloads it from Windows Update." />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ComboBox
                    Grid.Column="2"
                    MinWidth="170"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind vm:FeaturesViewModel.Filters}"
                    SelectedIndex="{x:Bind ViewModel.Features.FilterIndex, Mode=TwoWay}" />
                <AutoSuggestBox
                    Grid.Column="3"
                    Width="220"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    PlaceholderText="Search features"
                    Text="{x:Bind ViewModel.Features.SearchText, Mode=TwoWay}" />
                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.Features.RefreshCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Content="Remove all (AkariOS-Ultimate)"
                    Command="{x:Bind ViewModel.Features.RemoveAllCommand}"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Foreground="White" />
            </Grid>

            <Border
                Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,10,32,10" Opacity="0.7">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="FEATURE" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="STATE" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        Padding="0,0,16,0"
                        SelectionMode="None"
                        ItemsSource="{x:Bind ViewModel.Features.Filtered, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FeatureRowViewModel">
                                <Grid Padding="8,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Name}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind KeptText}"
                                            Visibility="{x:Bind IsKept}"
                                            Opacity="0.6"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind IsWorking, Mode=OneWay}" />
                                    <!-- Vain Toolbox's segmented pair: the state the feature is in reads as pressed. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton
                                            MinWidth="84"
                                            CornerRadius="4,0,0,4"
                                            Content="{x:Bind OffLabel}"
                                            IsChecked="{x:Bind IsOff, Mode=OneWay}"
                                            Command="{x:Bind TurnOffCommand}"
                                            CommandParameter="{x:Bind}" />
                                        <ToggleButton
                                            MinWidth="84"
                                            CornerRadius="0,4,4,0"
                                            Content="{x:Bind OnLabel}"
                                            IsChecked="{x:Bind IsOn, Mode=OneWay}"
                                            Command="{x:Bind TurnOnCommand}"
                                            CommandParameter="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.Features.StatusText, Mode=OneWay}" />
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.Features.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Uninstaller: unchanged from the page it used to be. -->
        <Grid x:Name="UninstallerTab" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: title, search, select-all, count, uninstall. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <AutoSuggestBox
                    Grid.Column="1"
                    Width="260"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    PlaceholderText="{x:Bind Strings.Get('Uninstaller.Search')}"
                    Text="{x:Bind ViewModel.Uninstaller.SearchText, Mode=TwoWay}" />

                <CheckBox
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    IsThreeState="True"
                    Content="{x:Bind Strings.Get('Uninstaller.SelectAll')}"
                    IsChecked="{x:Bind ViewModel.Uninstaller.IsSelectAllChecked, Mode=TwoWay}"
                    Command="{x:Bind ViewModel.Uninstaller.ToggleSelectAllCommand}" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Opacity="0.8">
                    <Run Text="{x:Bind ViewModel.Uninstaller.SelectedCount, Mode=OneWay}" />
                    <Run Text="{x:Bind Strings.Get('Uninstaller.Selected')}" />
                </TextBlock>

                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Content="{x:Bind Strings.Get('Uninstaller.UninstallSelected')}"
                    Command="{x:Bind ViewModel.Uninstaller.UninstallSelectedCommand}"
                    IsEnabled="{x:Bind ViewModel.Uninstaller.HasSelection, Mode=OneWay}"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Foreground="White" />
            </Grid>

            <TextBlock
                Grid.Row="1"
                TextWrapping="Wrap"
                Opacity="0.8"
                Text="{x:Bind Strings.Get('Uninstaller.Description')}" />

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.Uninstaller.AppsFoundText, Mode=OneWay}" />
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.Uninstaller.IsLoading, Mode=OneWay}" />
                <TextBlock
                    Opacity="0.8"
                    Visibility="{x:Bind ViewModel.Uninstaller.IsWorking, Mode=OneWay}"
                    Text="{x:Bind Strings.Get('Uninstaller.Working')}" />
            </StackPanel>

            <!-- App cards that fill the width: two across when there is room for two, one when there is
                 not, so the page never wraps to a single narrow column with half the window empty. -->
            <ScrollViewer Grid.Row="3" Padding="0,0,16,0">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Uninstaller.Filtered, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="340"
                            MinItemHeight="64"
                            MinRowSpacing="8"
                            MinColumnSpacing="8"
                            MaximumRowsOrColumns="2"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstalledAppEntryViewModel">
                            <Grid
                                Padding="14,10"
                                ColumnSpacing="14"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- A CheckBox keeps 120px for a label it does not have unless told otherwise. -->
                                <CheckBox
                                    MinWidth="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                                <Grid
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Stretch="Uniform"
                                        Source="{x:Bind Icon, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="20"
                                        Opacity="0.8"
                                        Glyph="&#xE71D;"
                                        Visibility="{x:Bind IsIconMissing, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                    <TextBlock
                                        Text="{x:Bind Publisher}"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
        <!-- Drivers: Vain Toolbox's Drivers tab, third-party driver packages grouped by class. -->
        <Grid x:Name="DriversTab" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button VerticalAlignment="Center" Content="Select all" Command="{x:Bind ViewModel.Drivers.SelectAllCommand}" />
                <Button Grid.Column="2" VerticalAlignment="Center" ToolTipService.ToolTip="Before you delete a driver">
                    <FontIcon FontSize="14" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <Button.Flyout>
                        <Flyout>
                            <TextBlock
                                MaxWidth="320"
                                TextWrapping="Wrap"
                                Text="A device whose driver is deleted stops working until Windows finds another. Windows refuses to delete a driver a connected device still needs; export a driver first to keep a copy you can install again." />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <AutoSuggestBox
                    Grid.Column="3"
                    Width="240"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    PlaceholderText="Search drivers"
                    Text="{x:Bind ViewModel.Drivers.SearchText, Mode=TwoWay}" />
                <Button Grid.Column="4" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh" Command="{x:Bind ViewModel.Drivers.LoadCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView
                    Padding="0,0,16,0"
                    SelectionMode="None"
                    ItemsSource="{x:Bind DriverGroups.View}">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:CleanupGroup">
                                    <TextBlock Text="{x:Bind Name}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanupRowViewModel">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Provider}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" MinWidth="80" VerticalAlignment="Center" Text="{x:Bind Date}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.Drivers.StatusText, Mode=OneWay}" />
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.Drivers.IsBusy, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Export selected" IsEnabled="{x:Bind ViewModel.Drivers.HasSelection, Mode=OneWay}" Command="{x:Bind ViewModel.Drivers.ExportSelectedCommand}" />
                <Button
                    Grid.Column="3"
                    Content="Delete selected"
                    IsEnabled="{x:Bind ViewModel.Drivers.HasSelection, Mode=OneWay}"
                    Command="{x:Bind ViewModel.Drivers.DeleteSelectedCommand}"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Foreground="White" />
            </Grid>
        </Grid>

        <!-- Devices: Vain Toolbox's Devices tab, devices Windows remembers that are not connected. -->
        <Grid x:Name="DevicesTab" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button VerticalAlignment="Center" Content="Select all" Command="{x:Bind ViewModel.Devices.SelectAllCommand}" />
                <AutoSuggestBox
                    Grid.Column="2"
                    Width="240"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    PlaceholderText="Search devices"
                    Text="{x:Bind ViewModel.Devices.SearchText, Mode=TwoWay}" />
                <Button Grid.Column="3" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh" Command="{x:Bind ViewModel.Devices.LoadCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView
                    Padding="0,0,16,0"
                    SelectionMode="None"
                    ItemsSource="{x:Bind DeviceGroups.View}">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:CleanupGroup">
                                    <TextBlock Text="{x:Bind Name}" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanupRowViewModel">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind ClassName}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.Devices.StatusText, Mode=OneWay}" />
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.Devices.IsBusy, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Clean up all" Command="{x:Bind ViewModel.Devices.CleanupAllCommand}" />
                <Button
                    Grid.Column="3"
                    Content="Clean up selected"
                    IsEnabled="{x:Bind ViewModel.Devices.HasSelection, Mode=OneWay}"
                    Command="{x:Bind ViewModel.Devices.CleanupSelectedCommand}" />
            </Grid>
        </Grid>

        <!-- Drives: Vain Toolbox's Drives tab, what fills a drive. Read-only. -->
        <Grid x:Name="DrivesTab" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <ComboBox
                    MinWidth="120"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Drives.Drives}"
                    SelectedItem="{x:Bind ViewModel.Drives.SelectedDrive, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.Drives.IsIdle, Mode=OneWay}" />
                <Button VerticalAlignment="Center" Command="{x:Bind ViewModel.Drives.ScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE721;" Visibility="{x:Bind ViewModel.Drives.IsIdle, Mode=OneWay}" />
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.Drives.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.Drives.IsScanning, Mode=OneWay}" />
                        <TextBlock Text="Scan drive" Visibility="{x:Bind ViewModel.Drives.IsIdle, Mode=OneWay}" />
                        <TextBlock Text="Stop" Visibility="{x:Bind ViewModel.Drives.IsScanning, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16,12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.7" Text="Scanned data" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Drives.ScannedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16,12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.7" Text="Files" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Drives.FilesText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16,12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.7" Text="Scan time" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Drives.TimeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.Drives.IsEmpty, Mode=OneWay}">
                <FontIcon FontSize="36" Glyph="&#xEDA2;" Opacity="0.8" />
                <TextBlock Opacity="0.8" Text="Select a drive and press Scan drive to see what fills it." />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="12" Visibility="{x:Bind ViewModel.Drives.HasResult, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="16,10" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="BIGGEST FOLDERS" />
                        <ListView Grid.Row="1" Padding="0,0,16,0" SelectionMode="None" ItemsSource="{x:Bind ViewModel.Drives.Folders}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiskEntryRow">
                                    <Grid Padding="0,6" ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Maximum="100" Value="{x:Bind Share}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind Size}" />
                                            <TextBlock HorizontalAlignment="Right" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Files}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border Grid.Column="1" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="16,10" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="BIGGEST FILES (CLICK TO SHOW IN EXPLORER)" />
                        <ListView
                            x:Name="LargestFilesList"
                            Grid.Row="1"
                            Padding="0,0,16,0"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnLargestFileClick"
                            ItemsSource="{x:Bind ViewModel.Drives.LargestFiles}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiskEntryRow">
                                    <Grid Padding="0,6" ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Path}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Size}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Page>
