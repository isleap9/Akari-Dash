<Page
    x:Class="AkariDash.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">

            <TextBlock
                Text="Akari-Dash"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                TextWrapping="Wrap"
                Opacity="0.8"
                Text="{x:Bind Strings.Get('Home.Greeting'), Mode=OneWay}" />

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Content="{x:Bind Strings.Get('Home.ApplyAllRecommended'), Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding ApplyAllRecommendedCommand}" />
                <Button Content="{x:Bind Strings.Get('Home.OpenSettings'), Mode=OneWay}" Command="{Binding OpenSettingsCommand}" />
                <Button Content="{x:Bind Strings.Get('Home.About'), Mode=OneWay}" Command="{Binding ShowAboutCommand}" />
            </StackPanel>

            <StackPanel
                Margin="0,12,0,0"
                Padding="16"
                Spacing="12"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock
                    Text="{x:Bind Strings.Get('Home.ThisPc'), Mode=OneWay}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <InfoBar
                    IsOpen="{Binding RunsAsOtherAccount}"
                    IsClosable="False"
                    Severity="Warning"
                    Title="{x:Bind Strings.Get('Home.OtherAccountTitle'), Mode=OneWay}"
                    Message="{Binding OtherAccountWarning}" />

                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Os'), Mode=OneWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Os}" />

                    <TextBlock Grid.Row="1" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Cpu'), Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Cpu}" />

                    <TextBlock Grid.Row="2" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Gpu'), Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Gpu}" />

                    <TextBlock Grid.Row="3" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Ram'), Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Ram}" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
