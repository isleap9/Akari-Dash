<Page
    x:Class="AkariDash.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariDash.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <TextBlock
                TextWrapping="Wrap"
                Opacity="0.8"
                Text="{x:Bind Strings.Get('Home.Greeting')}" />

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Content="{x:Bind Strings.Get('Home.ApplyAllRecommended')}"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding ApplyAllRecommendedCommand}" />
                <Button Content="{x:Bind Strings.Get('Home.OpenSettings')}" Command="{Binding OpenSettingsCommand}" />
                <Button Content="{x:Bind Strings.Get('Home.About')}" Command="{Binding ShowAboutCommand}" />
            </StackPanel>

            <StackPanel
                Margin="0,12,0,0"
                Padding="16"
                Spacing="12"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasRetiredTweaks, Mode=OneWay}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock
                    Text="{x:Bind Strings.Get('Home.RetiredTitle')}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.8"
                    Text="{x:Bind Strings.Get('Home.RetiredMessage')}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.RetiredTweaks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RetiredTweakViewModel">
                            <Grid Margin="0,8,0,0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Changes}" TextWrapping="Wrap" Opacity="0.8" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="Undo"
                                    Command="{x:Bind UndoCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel
                Margin="0,12,0,0"
                Padding="16"
                Spacing="12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock
                    Text="{x:Bind Strings.Get('Home.ThisPc')}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <InfoBar
                    IsOpen="{Binding RunsAsOtherAccount}"
                    IsClosable="False"
                    Severity="Warning"
                    Title="{x:Bind Strings.Get('Home.OtherAccountTitle')}"
                    Message="{Binding OtherAccountWarning}" />

                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Os')}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Os}" />

                    <TextBlock Grid.Row="1" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Cpu')}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Cpu}" />

                    <TextBlock Grid.Row="2" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Gpu')}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Gpu}" />

                    <TextBlock Grid.Row="3" Opacity="0.8" Text="{x:Bind Strings.Get('Home.Ram')}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{Binding Ram}" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
