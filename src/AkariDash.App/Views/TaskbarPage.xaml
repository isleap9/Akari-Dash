<Page
    x:Class="AkariDash.App.Views.TaskbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AkariDash.App.Views">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">

            <TextBlock
                Text="{x:Bind Strings.Get('Taskbar.Title')}"
                Style="{StaticResource TitleTextBlockStyle}" />

            <views:CategoryView ViewModel="{x:Bind ViewModel}" />

        </StackPanel>
    </ScrollViewer>
</Page>
