<Page
    x:Class="AkariDash.App.Views.GpusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariDash.App.ViewModels"
    xmlns:gpus="using:AkariDash.Core.Gpus">

    <Grid Padding="24,16,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Display, NVIDIA DRS and Scaling + colour join as tabs here. -->
        <SelectorBar x:Name="Tabs">
            <SelectorBarItem Text="Graphics card" IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE950;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <ScrollViewer x:Name="CardTab" Grid.Row="1" Padding="0,0,16,24">
            <StackPanel Spacing="16">

                <!-- No NVIDIA, AMD or Intel card, as Vain Toolbox says it. -->
                <Border
                    Padding="24"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasNoCards}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE950;" FontSize="32" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No NVIDIA, AMD or Intel GPU detected" />
                        <TextBlock HorizontalAlignment="Center" Opacity="0.8" Text="Only NVIDIA, AMD and Intel graphics cards are listed here." />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasCards}">

                    <ComboBox
                        MinWidth="320"
                        Header="Graphics card"
                        Visibility="{x:Bind ViewModel.HasSeveralCards}"
                        ItemsSource="{x:Bind ViewModel.Cards}"
                        SelectedItem="{x:Bind ViewModel.SelectedCard, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="gpus:GpuCard">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid
                        Padding="16"
                        ColumnSpacing="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Padding="8,2" CornerRadius="4" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Vendor, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <Border Padding="8,2" CornerRadius="4" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.Kind, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Restart GPU"
                            ToolTipService.ToolTip="Stop and start the card's driver, as Device Manager would"
                            Command="{x:Bind ViewModel.RestartCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GpuFact">
                                <Grid
                                    Margin="0,0,0,4"
                                    Padding="16,12"
                                    ColumnSpacing="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
