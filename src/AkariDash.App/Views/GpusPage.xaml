<Page
    x:Class="AkariDash.App.Views.GpusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A placeholder until #33 (GPUs: the registry Tweaks) and the driver tools ADR-0004 puts here. -->
    <Grid Padding="24">
        <StackPanel
            MaxWidth="520"
            Padding="32"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <FontIcon FontSize="40" Glyph="&#xE7F8;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Work in progress" />
            <TextBlock
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Opacity="0.8"
                Text="GPU settings for NVIDIA, AMD and Intel cards, driver installs and a clean driver reset with DDU will live here." />
        </StackPanel>
    </Grid>
</Page>
