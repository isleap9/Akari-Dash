<Page
    x:Class="AkariDash.App.Views.GpusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariDash.App.ViewModels"
    xmlns:gpus="using:AkariDash.Core.Gpus">

    <Grid Padding="24,16,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Vain Toolbox's GPU page: tabs on the left, the card's actions as icon buttons on the right.
             Settings, Display and DRS join as tabs here. -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                <SelectorBarItem Text="Main" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="Settings">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- Vain Toolbox's Settings buttons: reset to defaults, revert unapplied changes, apply. -->
            <StackPanel x:Name="SettingsButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Padding="8" ToolTipService.ToolTip="Reset display settings to defaults" Command="{x:Bind ViewModel.Settings.ResetCommand}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
                <Button Padding="8" ToolTipService.ToolTip="Revert unapplied changes" Command="{x:Bind ViewModel.Settings.RevertCommand}">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button Padding="8" ToolTipService.ToolTip="Apply display settings" Command="{x:Bind ViewModel.Settings.ApplyCommand}">
                    <FontIcon FontSize="16" Glyph="&#xE73E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>

            <StackPanel x:Name="MainButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Padding="8"
                    Visibility="{x:Bind ViewModel.HasCards}"
                    ToolTipService.ToolTip="Restart GPU - stop and start the card's driver; the screen goes black for a few seconds"
                    Command="{x:Bind ViewModel.RestartCommand}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="MainTab" Grid.Row="1" Padding="0,0,16,24">
            <StackPanel Spacing="16">

                <!-- No NVIDIA, AMD or Intel card, as Vain Toolbox says it. -->
                <Border
                    Padding="24"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasNoCards}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE950;" FontSize="32" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No NVIDIA, AMD or Intel GPU detected" />
                        <TextBlock HorizontalAlignment="Center" Opacity="0.8" Text="Only NVIDIA, AMD and Intel graphics cards are listed here." />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasCards}">

                    <ComboBox
                        MinWidth="320"
                        Visibility="{x:Bind ViewModel.HasSeveralCards}"
                        ItemsSource="{x:Bind ViewModel.Cards}"
                        SelectedItem="{x:Bind ViewModel.SelectedCard, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="gpus:GpuCard">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- The card's header: name with its iGPU/dGPU badge, a rule, then the facts in columns. -->
                    <Border
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel>
                            <StackPanel Padding="16,14" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
                                <Border VerticalAlignment="Center" Padding="6,1" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock FontSize="11" Text="{x:Bind ViewModel.Kind, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <ItemsControl Margin="16,14,16,16" ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="40" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GpuFact">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="12" Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Visibility="{x:Bind Plain}" Text="{x:Bind Value}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                            <TextBlock Visibility="{x:Bind Accent}" Text="{x:Bind Value}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Vain Toolbox's Registry Settings: NVIDIA cards only. -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasRegistrySettings, Mode=OneWay}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Registry Settings" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The driver reads these when it starts: changes take effect after Restart GPU or a reboot." />
                            </StackPanel>
                            <AutoSuggestBox
                                Grid.Column="1"
                                Width="240"
                                VerticalAlignment="Center"
                                QueryIcon="Find"
                                PlaceholderText="Search settings..."
                                Text="{x:Bind ViewModel.RegistrySearch, Mode=TwoWay}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.RegistryGroups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NvidiaRegistryGroupViewModel">
                                    <Expander
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" Text="Recommended" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <Button Grid.Column="2" Padding="8,6" ToolTipService.ToolTip="Apply every recommended value in this group" Command="{x:Bind ApplyAllRecommendedCommand}">
                                                    <FontIcon FontSize="14" Glyph="&#xE945;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Button>
                                                <Button Grid.Column="3" Padding="8,6" ToolTipService.ToolTip="Delete every value in this group: the driver uses its own defaults" Command="{x:Bind DeleteAllCommand}">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{x:Bind Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NvidiaRegistryRowViewModel">
                                                    <Grid Padding="0,4" ColumnSpacing="8" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" IsTextSelectionEnabled="True" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="Vain Toolbox's recommended value">
                                                            <FontIcon FontSize="10" Glyph="&#xE73E;" Opacity="{x:Bind CheckOpacity(IsRecommended), Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{x:Bind RecommendedText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </StackPanel>
                                                        <TextBox Grid.Column="2" Width="110" FontFamily="Consolas" MaxLength="10" PlaceholderText="not set" Text="{x:Bind Typed, Mode=TwoWay}" />
                                                        <Button Grid.Column="3" Padding="8,6" ToolTipService.ToolTip="Write the recommended value" Command="{x:Bind ApplyRecommendedCommand}">
                                                            <FontIcon FontSize="14" Glyph="&#xE945;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </Button>
                                                        <Button Grid.Column="4" Padding="8,6" ToolTipService.ToolTip="Write the value in the box" Command="{x:Bind ApplyTypedCommand}">
                                                            <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </Button>
                                                        <Button Grid.Column="5" Padding="8,6" ToolTipService.ToolTip="Delete the value: the driver uses its own default" Command="{x:Bind DeleteCommand}">
                                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Vain Toolbox's Settings tab: one NVIDIA display at a time, its colour output and scaling on the
             left, HDR10 and the colour adjustments on the right. -->
        <ScrollViewer x:Name="SettingsTab" Grid.Row="1" Padding="0,0,16,24" Visibility="Collapsed">
            <StackPanel Spacing="16">
                <TextBlock Visibility="{x:Bind ViewModel.Settings.HasNoDisplays, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap"
                           Text="Settings needs an NVIDIA card with a display connected." />

                <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.Settings.HasDisplays, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border VerticalAlignment="Top" Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Display Adapter" />
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.Settings.Displays, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.Settings.SelectedDisplay, Mode=TwoWay}" DisplayMemberPath="Name" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Color Format" />
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.Settings.ColorFormats}"
                                          SelectedIndex="{x:Bind ViewModel.Settings.ColorFormatIndex, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Dynamic Range" />
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.Settings.DynamicRanges}"
                                          SelectedIndex="{x:Bind ViewModel.Settings.DynamicRangeIndex, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Color Depth" />
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.Settings.ColorDepths}"
                                          SelectedIndex="{x:Bind ViewModel.Settings.ColorDepthIndex, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Scaling Mode" />
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.Settings.ScalingModes}"
                                          SelectedIndex="{x:Bind ViewModel.Settings.ScalingModeIndex, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Perform Scaling On" />
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.Settings.ScalingPerformers}"
                                          SelectedIndex="{x:Bind ViewModel.Settings.ScalingPerformerIndex, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Override Scaling Mode Set by Games and Programs" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsEnabled="{x:Bind ViewModel.Settings.OverrideScalingAvailable, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.Settings.OverrideScaling, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="GPU Performance Counters for All Users" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.Settings.PerformanceCounters, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" VerticalAlignment="Top" Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="HDR10" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Settings.Hdr10Support, Mode=OneWay}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsEnabled="{x:Bind ViewModel.Settings.Hdr10Supported, Mode=OneWay}"
                                              IsOn="{x:Bind ViewModel.Settings.Hdr10, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Color channel" />
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{x:Bind ViewModel.Settings.ColorChannels}"
                                          SelectedIndex="{x:Bind ViewModel.Settings.ColorChannelIndex, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Brightness" />
                                <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind ViewModel.Settings.Brightness, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Contrast" />
                                <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind ViewModel.Settings.Contrast, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Gamma" />
                                <Slider Minimum="0.3" Maximum="2.8" StepFrequency="0.01"
                                        Value="{x:Bind ViewModel.Settings.Gamma, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Digital Vibrance" />
                                <Slider Minimum="0" Maximum="{x:Bind ViewModel.Settings.VibranceMax, Mode=OneWay}" StepFrequency="1"
                                        IsEnabled="{x:Bind ViewModel.Settings.VibranceSupported, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.Settings.Vibrance, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Hue" />
                                <Slider Minimum="0" Maximum="360" StepFrequency="1"
                                        IsEnabled="{x:Bind ViewModel.Settings.HueSupported, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.Settings.Hue, Mode=TwoWay}" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Override to Reference Mode" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.Settings.ReferenceMode, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
