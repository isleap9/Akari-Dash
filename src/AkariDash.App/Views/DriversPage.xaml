<Page
    x:Class="AkariDash.App.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariDash.App.ViewModels">

    <!-- The Drivers page: AkariOS-Ultimate's Graphics category, one row per entry, drawn as AkariOS
         draws a row (Akari.ps1 New-Row): a dot for a Toggle, the name and description, the risk, and
         the buttons - Optimize and Default for a Toggle, one button for an Action, and Options for a
         Group, which opens one row per choice. The page title and subtitle come from the shell. -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="0,0,16,0">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:GraphicsEntryViewModel">
                        <Border
                            Padding="12,9"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The state dot, on Toggles only: filled once Optimize ran, empty after
                                         Default, faint when neither has been pressed. -->
                                    <Grid
                                        Width="9"
                                        Height="9"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Opacity="{x:Bind DotOpacity, Mode=OneWay}"
                                        Visibility="{x:Bind IsToggle}">
                                        <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                                        <Ellipse Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind IsOptimized, Mode=OneWay}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="Medium" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Opacity="0.7"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap"
                                            Text="{x:Bind Description}" />
                                    </StackPanel>

                                    <!-- The risk, coloured as AkariOS colours it. -->
                                    <Grid Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                        <Border Padding="7,1" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsSafe}">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Risk}" />
                                        </Border>
                                        <Border Padding="7,1" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsCaution}">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind Risk}" />
                                        </Border>
                                        <Border Padding="7,1" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsAdvanced}">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind Risk}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsWorking, Mode=OneWay}" />

                                        <!-- Toggle: Optimize (the accent button once it ran) and Default. -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="{x:Bind IsToggle}"
                                            ToolTipService.ToolTip="{x:Bind UnavailableReason}">
                                            <Button
                                                Content="Optimize"
                                                Style="{StaticResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind IsAvailable}"
                                                Command="{x:Bind OptimizeCommand}"
                                                Visibility="{x:Bind IsOptimized, Mode=OneWay}" />
                                            <Button
                                                Content="Optimize"
                                                IsEnabled="{x:Bind IsAvailable}"
                                                Command="{x:Bind OptimizeCommand}"
                                                Visibility="{x:Bind IsNotOptimized, Mode=OneWay}" />
                                            <Button Content="Default" IsEnabled="{x:Bind IsAvailable}" Command="{x:Bind DefaultCommand}" />
                                        </StackPanel>

                                        <!-- Action: its one button. -->
                                        <Button Content="{x:Bind Button}" Command="{x:Bind RunCommand}" Visibility="{x:Bind IsAction}" />

                                        <!-- Group: Options opens the choices below. -->
                                        <Button Content="Options" Command="{x:Bind ToggleOptionsCommand}" Visibility="{x:Bind IsGroup}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="22,12,0,0" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                                    <Border Margin="0,0,0,10" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Options}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GraphicsOptionViewModel">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" />
                                                        <TextBlock
                                                            Opacity="0.7"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            TextWrapping="Wrap"
                                                            Text="{x:Bind Description}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Content="{x:Bind Button}"
                                                        IsEnabled="{x:Bind IsAvailable}"
                                                        ToolTipService.ToolTip="{x:Bind UnavailableReason}"
                                                        Command="{x:Bind RunCommand}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
