<Page
    x:Class="AkariDash.App.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariDash.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.8"
                    Text="AkariOS-Ultimate's own graphics scripts, run as they are there. They cannot be undone from Akari Dash; where a row has Revert, that is the script's own way back." />
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Text="{x:Bind ViewModel.CardsText}" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Entries}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GraphicsEntryViewModel">
                        <Grid
                            Margin="0,0,0,4"
                            Padding="16"
                            ColumnSpacing="16"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.8" />
                            </StackPanel>

                            <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Bind Actions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GraphicsActionViewModel">
                                        <Button
                                            MinWidth="96"
                                            Content="{x:Bind Label}"
                                            ToolTipService.ToolTip="{x:Bind Description}"
                                            Command="{x:Bind RunCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
