<Page
    x:Class="AkariDash.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariDash.App.ViewModels">

    <!-- The Downloads page: the curated catalogue as tiles, filtered by chip and by search, picked by
         clicking the cards and installed through winget one button at a time. The page title and
         subtitle come from the shell, as they do for every other page. -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Category chips and the search box, as the Store apps tab pairs its filter with its search. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Categories}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChipViewModel">
                        <ToggleButton
                            Content="{x:Bind Label}"
                            Padding="11,4"
                            CornerRadius="4"
                            IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <AutoSuggestBox
                Grid.Column="1"
                Width="240"
                VerticalAlignment="Center"
                QueryIcon="Find"
                PlaceholderText="Search apps"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
        </Grid>

        <!-- Picking is clicking the card, and one button installs what was picked: the count is in the
             button, so the bar carries no separate label. Select all takes what the filter and search
             show. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button
                Style="{StaticResource AccentButtonStyle}"
                Content="{x:Bind ViewModel.InstallSelectedLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.InstallSelectedCommand}" />
            <Button VerticalAlignment="Center" Content="Select all" Command="{x:Bind ViewModel.SelectAllCommand}" />
            <Button VerticalAlignment="Center" Content="Clear" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <!-- Three across, one card per app: an avatar square, the app, and where its install is. -->
        <ScrollViewer Grid.Row="3" Padding="0,0,16,0">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Filtered, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="300"
                        MinItemHeight="186"
                        MinRowSpacing="8"
                        MinColumnSpacing="8"
                        MaximumRowsOrColumns="3"
                        ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppTileViewModel">
                        <Grid>
                            <Grid
                                Height="186"
                                Padding="18,16"
                                RowSpacing="10"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Width="40"
                                            Height="40"
                                            CornerRadius="8"
                                            Background="{x:Bind AccentColor}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{x:Bind Initial}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Publisher}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- The tick is the card's own answer to a click: it shows only when
                                         the tile is picked, so there is no dead control sitting greyed
                                         out on a tile that cannot be picked. -->
                                    <Border
                                        Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Top"
                                        CornerRadius="4"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Glyph="&#xE73E;" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Opacity="0.8"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    MaxLines="2"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Description}" />

                                <StackPanel
                                    Grid.Row="2"
                                    VerticalAlignment="Bottom"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind IsInstalling, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StateText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- The accent outline a picked card wears, over the card's own 1px border,
                                 so the two never have to share one BorderBrush. -->
                            <Border
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="{x:Bind HighlightThickness, Mode=OneWay}" />

                            <!-- The card is the control: one transparent button over the whole tile gives
                                 the click, the hover tint, the focus ring and the keyboard, and changes
                                 nothing about how the card itself is drawn. A card that cannot be picked
                                 takes no part in pointer input at all, so it never lights up under the
                                 pointer on its way to doing nothing. -->
                            <Button
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="0"
                                Background="Transparent"
                                IsHitTestVisible="{x:Bind IsInstallable, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                ToolTipService.ToolTip="Click the card to pick it"
                                Command="{x:Bind ToggleSelectionCommand}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
