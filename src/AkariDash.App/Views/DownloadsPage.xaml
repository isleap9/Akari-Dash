<Page
    x:Class="AkariDash.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AkariDash.App.Views"
    xmlns:vm="using:AkariDash.App.ViewModels">

    <!-- The Downloads page: the curated catalogue as tiles, filtered by chip and by search, each
         installed through winget. The page title and subtitle come from the shell, as they do for
         every other page. -->
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Category chips and the search box, as the Store apps tab pairs its filter with its search. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Categories}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChipViewModel">
                        <ToggleButton
                            Content="{x:Bind Label}"
                            Padding="11,4"
                            CornerRadius="4"
                            IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <AutoSuggestBox
                Grid.Column="1"
                Width="240"
                VerticalAlignment="Center"
                QueryIcon="Find"
                PlaceholderText="Search apps"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <!-- Three across, one card per app: an avatar square, the app, and where its install is. -->
        <ScrollViewer Grid.Row="2" Padding="0,0,16,0">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Filtered, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="300"
                        MinItemHeight="186"
                        MinRowSpacing="8"
                        MinColumnSpacing="8"
                        MaximumRowsOrColumns="3"
                        ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppTileViewModel">
                        <Grid
                            Height="186"
                            Padding="18,16"
                            RowSpacing="10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border
                                    Width="40"
                                    Height="40"
                                    CornerRadius="8"
                                    Background="{x:Bind AccentColor}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{x:Bind Initial}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Publisher}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Opacity="0.8"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                MaxLines="2"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{x:Bind Description}" />

                            <Grid Grid.Row="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    MinWidth="96"
                                    Content="Install"
                                    Command="{x:Bind InstallCommand}"
                                    IsEnabled="{x:Bind IsInstallable, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind IsInstalling, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StateText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
