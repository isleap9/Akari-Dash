<Window
    x:Class="AkariDash.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariDash.App">

    <Grid x:Name="RootElement" Background="Transparent">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Source="{x:Bind AppIconSource}"
                    Width="16"
                    Height="16"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="TitleText"
                    Text="{x:Bind AppTitle}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Shell content -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="232"
            SelectionChanged="OnNavSelectionChanged"
            MenuItemsSource="{x:Bind NavItems}"
            FooterMenuItemsSource="{x:Bind FooterNavItems}">

            <!-- Searches every Tweak on every page, by title, Group, Option or the value it writes.
                 Picking one goes to its page and scrolls it into view. -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    QueryIcon="Find"
                    PlaceholderText="Search Tweaks"
                    TextChanged="OnSearchTextChanged"
                    SuggestionChosen="OnSearchSuggestionChosen"
                    QuerySubmitted="OnSearchQuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchResult">
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{x:Bind Title}" />
                                <TextBlock
                                    Text="{x:Bind Detail}"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <!-- One template for every level: a leaf has no Children, so it gets no chevron, and a
                 parent has no page, so picking it only opens the branch. A branch starts closed;
                 RefreshShellState opens it when the user lands on one of its pages another way. -->
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="local:NavigationItem">
                    <NavigationViewItem
                        Content="{x:Bind Label}"
                        Tag="{x:Bind PageType}"
                        MenuItemsSource="{x:Bind Children}"
                        SelectsOnInvoked="{x:Bind IsPage}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Persistent in Phase 1 builds: cannot be closed. -->
                <InfoBar
                    x:Name="DryRunBanner"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{x:Bind IsDryRunOnly}"
                    Title="{x:Bind Strings.Get('DryRunBanner.Title')}"
                    Message="{x:Bind Strings.Get('DryRunBanner.Message')}" />

                <Frame Grid.Row="1" x:Name="ContentFrame" />

                <InfoBar
                    Grid.Row="2"
                    x:Name="ShellInfoBar"
                    Title="{x:Bind InfoBar.Title, Mode=OneWay}"
                    Message="{x:Bind InfoBar.Message, Mode=OneWay}"
                    Severity="{x:Bind InfoBar.Severity, Mode=OneWay}"
                    IsClosable="{x:Bind InfoBar.IsClosable, Mode=OneWay}"
                    IsOpen="{x:Bind InfoBar.IsOpen, Mode=TwoWay}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
