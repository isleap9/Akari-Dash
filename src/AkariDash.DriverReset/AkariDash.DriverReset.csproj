<Project Sdk="Microsoft.NET.Sdk">

  <!-- The safe-mode half of a DDU clean (ADR-0001, amended 2026-10-13): a small console exe beside
       the app instead of a .ps1 run through RunOnce. Self-contained like the app, so the app can
       reference it and the build puts it in the app's own folder, on the app's own runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AkariDash.DriverReset</RootNamespace>
    <AssemblyName>AkariDash.DriverReset</AssemblyName>
    <UseWinUI>false</UseWinUI>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkariDash.Core\AkariDash.Core.csproj" />
  </ItemGroup>

</Project>
